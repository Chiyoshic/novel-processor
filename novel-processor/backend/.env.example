APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
API_PORT=64226

# Persistent data paths inside the backend container.
DATA_DIR=/app/data
DB_PATH=/app/data/library.db
NOVELS_DIR=/app/data/novels
EPISODES_DIR=/app/data/episodes
AUDIT_LOG_PATH=/app/data/audit.log

# Fetching controls.
FETCH_CONCURRENCY=4
FETCH_INTERVAL_MS=200
FETCH_TIMEOUT_MS=20000
FETCH_MAX_RETRIES=3

# Comma-separated origins. Leave empty when a reverse proxy serves the frontend.
CORS_ORIGINS=https://novels.chiyoshi.cn

# Required only when the SQLite database has no users. Never resets existing passwords.
AUTH_INITIAL_USERNAME=chiyoshi
AUTH_INITIAL_PASSWORD=
# auto: Secure on HTTPS browser origins, HTTP allowed for local development.
AUTH_COOKIE_SECURE=auto
AUTH_COOKIE_SAMESITE=lax
