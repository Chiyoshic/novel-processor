{
  "name": "novel-processor-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "prebuild": "npm run generate:icons",
    "test:pwa": "npm run build && node scripts/test-pwa.mjs",
    "test:appearance": "node --test scripts/browser-chrome.test.mjs",
    "test:select": "node --test scripts/app-select.test.mjs"
  },
  "dependencies": {
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.3.11"
  }
}
